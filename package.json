{
  "name": "localai",
  "displayName": "LocalAI",
  "description": "Offline AI coding assistant — no API keys, no internet",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["AI"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "localai.explain",
        "title": "LocalAI: Explain Code"
      },
      {
        "command": "localai.fix",
        "title": "LocalAI: Fix Bug"
      },
      {
        "command": "localai.tests",
        "title": "LocalAI: Write Tests"
      },
      {
        "command": "localai.refactor",
         "title": "LocalAI: Refactor File"
      }
    ],
    "keybindings": [
      {
        "command": "localai.explain",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      },
      {
        "command": "localai.fix",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "localai.tests",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      },
      {
       "command": "localai.refactor",
       "key": "ctrl+shift+r",
       "mac": "cmd+shift+r",
       "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "localai.explain",
          "group": "localai@1",
          "when": "editorHasSelection"
        },
        {
          "command": "localai.fix",
          "group": "localai@2",
          "when": "editorHasSelection"
        },
        {
          "command": "localai.tests",
          "group": "localai@3",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}